# Keep this a deny list: the build needs the whole source tree (app, src,
# public, scripts, configs).
node_modules
.next
dist
coverage
.git
.github
.preview
.claude
.agents

# Secrets and local overrides never enter an image layer.
.env
.env.*
!.env.example

# Not needed to build or run the server.
tests
docs
wiki
*.md
.editorconfig
.prettier*
vitest.config.mts
compose.yaml
scripts/preview.mjs
scripts/recon.mjs

# Captured API traffic and driven-browser profiles: every line carries whatever
# credentials the site sent.
probe-out
.browser-profile
