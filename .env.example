# Every value here is optional. The app has no secrets, no database and no
# accounts of its own: the only credentials involved are the user's own platform
# tokens, which live in their browser and never reach this server's storage.
#
# Copy to `.env` only if you want to change a default:
#   cp .env.example .env

# --- Runtime (read on every start; a restart is enough to change them) ------

# Port the container publishes on the host. Inside the container the server
# always listens on 3000.
APP_PORT=3000

# Image compose pulls. Pin a version instead of `latest` for a stable deploy.
# APP_IMAGE=ghcr.io/amiranmanesh/discount-hunter:3.0.0

# Which *other* origins may call this proxy, comma-separated, no trailing slash.
# Leave empty for the normal case: the app is served by this same server, so it
# is same-origin and no CORS rule applies. Never set this to `*` — the proxy
# forwards whatever Authorization header it is handed, so any origin listed here
# is an origin that can spend a user's session.
# ALLOWED_ORIGINS=https://app.example.ir,https://staging.example.ir

# Reported by /api/health. Useful for telling two deploys apart.
# APP_VERSION=3.0.0

# --- Build-time (baked into the bundle; a restart will NOT change them) -----

# Where the browser sends its API calls. Unset means `/api` on the app's own
# origin, which is what you want in essentially every deploy — including on a
# personal domain and behind a reverse proxy. Set it only when the UI is hosted
# apart from its proxy, and then the proxy needs this origin in ALLOWED_ORIGINS.
# NEXT_PUBLIC_API_BASE=https://proxy.example.ir/api

# --- Build mirrors (only for a restricted network) --------------------------
# NODE_IMAGE=hub.hamdocker.ir/node:22-alpine
# NPM_REGISTRY=https://registry.npmmirror.com
